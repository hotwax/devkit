{
  "name": "@hotwax/devkit",
  "version": "0.1.0",
  "description": "Local dev cockpit for Moqui / Maarg — preflight, a JVM→PWA system-architecture map, click-to-Start/Stop/Restart, and expected-component checks. Runs via npx, no install.",
  "type": "module",
  "bin": {
    "devkit": "./moqui-console.mjs",
    "hotwax-check-notnaked": "./check-notnaked-access.mjs",
    "hotwax-check-readiness": "./check-notnaked-readiness.mjs",
    "hotwax-unblock-report": "./notnaked-unblock-report.mjs",
    "hotwax-bootstrap": "./bootstrap-hotwax-local.mjs",
    "hotwax-devkit-control": "./devkit-control.mjs",
    "hotwax-devkit-self-check": "./devkit-self-check.mjs",
    "moqui-console": "./moqui-console.mjs"
  },
  "files": [
    "moqui-console.mjs",
    "moqui-console.html",
    "devkit-control.mjs",
    "bootstrap-hotwax-local.mjs",
    "gitless-clone.mjs",
    "pwa-dependency-bridge.mjs",
    "check-notnaked-access.mjs",
    "check-notnaked-readiness.mjs",
    "notnaked-unblock-report.mjs",
    "notnaked-bundle-discovery.mjs",
    "notnaked-bundle-request.mjs",
    "notnaked-access-summary.mjs",
    "devkit-self-check.mjs",
    "notnaked-target.json",
    "test/devkit-self-check.test.mjs",
    "test/gitless-clone.test.mjs",
    "test/pwa-dependency-bridge.test.mjs",
    "test/notnaked-access-summary.test.mjs",
    "test/notnaked-bundle-discovery.test.mjs",
    "test/notnaked-bundle-request.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node moqui-console.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "moqui",
    "maarg",
    "hotwax",
    "oms",
    "dev-console",
    "devkit",
    "devops"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotwax/devkit.git"
